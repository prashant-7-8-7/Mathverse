# MathVerse Configuration Template
# Server Port
PORT=3000

# Executive Master Admin Password (REQUIRED for admin access - server refuses login if empty)
ADMIN_PASSWORD=your_secure_admin_password_here

# Automatic Demo Seeding (Set to 'true' to auto-populate a fresh database on startup)
SEED_DEMO=false

# Demo Member Shared Password (Used for all seeded demo member profiles, default: demo1234)
DEMO_PASSWORD=demo1234
